<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_pick_place_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for UR5 vision-based pick and place</description>
  <maintainer email="your.email@example.com">Aakash Kavi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>ur5_pick_place_perception</exec_depend>
  <exec_depend>ur5_pick_place_manipulation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
