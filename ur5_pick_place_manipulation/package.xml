<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_pick_place_manipulation</name>
  <version>0.1.0</version>
  <description>
    MoveIt! 2 pick-and-place execution node.
    Subscribes to detected object poses and executes
    pre-grasp -> grasp -> retreat -> home sequences.
  </description>
  <maintainer email="your.email@example.com">Aakash Kavi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
